# EXAMPLE ONLY. Copy the required entries into the server's private environment.
# No provider connection, synchronization or send is enabled by default.
MAILBOX_WORKER_ENABLED=false
MAILBOX_SEND_ENABLED=false
# Existing BACKGROUND_JOBS_ENABLED=false also disables the mailbox worker.

# Run scripts/prepare-mailboxes.cjs; it creates and preserves valid keys privately.
# 32 cryptographically random bytes per key, encoded in base64.
# Keep the key outside the database and repository. Never use these placeholders.
MAILBOX_ENCRYPTION_KEY_ID=mail-v1
MAILBOX_ENCRYPTION_KEYS={"mail-v1":"REPLACE_PRIVATELY_WITH_BASE64_32_RANDOM_BYTES"}
# Absolute directory outside cronox-front, with restricted OS access.
# Mount the SAME private directory on every backend instance.
MAILBOX_PRIVATE_DIR=

# Existing SMTP_SUPPORT_PASS, SMTP_ORDERS_PASS, SMTP_NOREPLY_PASS,
# SMTP_INFO_PASS can be referenced by name in the panel without copying them.
# No fifth address is assumed or created.
# Local-only opt-in: read these current references from .env at each local startup.
# MAILBOX_LOCAL_SMTP_REFERENCES=true

# The preparation script generates VAPID privately; never put its private key in frontend code.
MAILBOX_VAPID_PUBLIC_KEY=
MAILBOX_VAPID_PRIVATE_KEY=
MAILBOX_VAPID_SUBJECT=

MAILBOX_MAX_MESSAGE_BYTES=26214400
MAILBOX_MAX_ATTACHMENT_BYTES=10485760
MAILBOX_MAX_RECIPIENTS=20

# Circle campaigns stay blocked until the contracted plan and authentication
# alignment have been reviewed. These do not change manual mailbox sending.
MAILBOX_CAMPAIGN_ENABLED=false
MAILBOX_CAMPAIGN_PROVIDER_VERIFIED=false
# Set confirmed per-mailbox rolling daily quota; no assumed plan or default quota.
MAILBOX_CAMPAIGN_DAILY_LIMIT=
# Local campaign hourly ceiling (provider may impose additional limits).
MAILBOX_CAMPAIGN_HOURLY_LIMIT=
# Leave this much daily capacity for transactional/manual/external mail; must be >0.
MAILBOX_CAMPAIGN_TRANSACTIONAL_RESERVE=
# One delivery/connection at a time, globally; minimum 30 seconds, durable clock.
MAILBOX_CAMPAIGN_INTERVAL_SECONDS=30
