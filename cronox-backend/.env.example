# Copy this file to cronox-backend/.env and replace every placeholder locally.
# Never commit an actual .env file.
NODE_ENV=development
PORT=3000

# Public browser/API origins (use HTTPS values in production).
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY_HOPS=0
ENABLE_SWAGGER=false

# PostgreSQL
DATABASE_URL=postgresql://CRONOX_USER:REPLACE_WITH_PASSWORD@localhost:5432/cronox?schema=public

# JWT: two distinct, randomly generated secrets, at least 32 characters each.
JWT_ACCESS_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_ACCESS_SECRET_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_REFRESH_SECRET_AT_LEAST_32_CHARS
BCRYPT_SALT_ROUNDS=12

# Stripe (server-only secrets; use test values locally).
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_STRIPE_SECRET
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_STRIPE_WEBHOOK_SECRET

# Global and sensitive-route throttling.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

# Email delivery is disabled by default outside production. Setting this to true
# requires every SMTP_* and EMAIL_* variable below, with real local/deployment values.
EMAIL_ENABLED=false
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=465
SMTP_SECURE=true
SMTP_SUPPORT_USER=REPLACE_WITH_SUPPORT_EMAIL
SMTP_SUPPORT_PASS=REPLACE_WITH_SUPPORT_PASSWORD
SMTP_ORDERS_USER=REPLACE_WITH_ORDERS_EMAIL
SMTP_ORDERS_PASS=REPLACE_WITH_ORDERS_PASSWORD
SMTP_NOREPLY_USER=REPLACE_WITH_NOREPLY_EMAIL
SMTP_NOREPLY_PASS=REPLACE_WITH_NOREPLY_PASSWORD
SMTP_INFO_USER=REPLACE_WITH_INFO_EMAIL
SMTP_INFO_PASS=REPLACE_WITH_INFO_PASSWORD
EMAIL_DEFAULT_FROM_NAME=CRONOX
EMAIL_SUPPORT_FROM_NAME=CRONOX Support
EMAIL_ORDERS_FROM_NAME=CRONOX Orders
EMAIL_NOREPLY_FROM_NAME=CRONOX
EMAIL_INFO_FROM_NAME=CRONOX

# Disabled unless explicitly enabled in a non-production environment. Keep the
# token out of source control and send it only in the X-Dev-Email-Token header.
DEV_EMAIL_TEST_ENABLED=false
DEV_EMAIL_TEST_TOKEN=REPLACE_WITH_A_RANDOM_DEV_EMAIL_TEST_TOKEN
