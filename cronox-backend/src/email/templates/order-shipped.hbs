<!doctype html>
<html lang="es">
  <body style="margin:0;padding:0;background:#000000;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#000000;padding:32px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px;background:#0b0b0b;border:1px solid #1d1d1d;border-radius:14px;overflow:hidden;">
            <tr>
              <td style="padding:30px 32px 22px 32px;border-bottom:1px solid #1a1a1a;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td align="left" valign="top">
                      <div style="font-family:Georgia,'Times New Roman',serif;font-size:34px;line-height:1;color:#ffffff;font-weight:700;letter-spacing:0.04em;">
                        CRONOX
                      </div>
                    </td>
                    <td align="right" valign="top">
                      <div style="font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:1.5;color:#8f8f8f;letter-spacing:0.12em;text-transform:uppercase;">
                        Pedido n.º
                      </div>
                      <div style="font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:1.5;color:#ffffff;font-weight:700;">
                        #{{orderId}}
                      </div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style="padding:28px 32px 10px 32px;">
                <div style="font-family:Arial,Helvetica,sans-serif;font-size:30px;line-height:1.2;color:#ffffff;font-weight:700;">
                  Buenas noticias. Tu pedido está en camino.
                </div>

                <div style="padding-top:14px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.8;color:#d7d7d7;">
                  Nuestro equipo ya ha preparado tu envío y ha salido correctamente.
                  {{#if shippingCarrier}}
                  El transportista asignado es <span style="color:#ffffff;font-weight:700;">{{shippingCarrier}}</span>.
                  {{/if}}
                  {{#if statusLabel}}
                  Estado actual: <span style="color:#ffffff;font-weight:700;">{{statusLabel}}</span>.
                  {{/if}}
                </div>

                <div style="padding-top:18px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.8;color:#b5b5b5;">
                  Puedes revisar los artículos incluidos en este envío y acceder al pedido desde los enlaces de abajo.
                  {{#if trackingNumber}}
                  Tu número de seguimiento es <span style="color:#ffffff;font-weight:600;">{{trackingNumber}}</span>.
                  {{/if}}
                </div>
              </td>
            </tr>

            <tr>
              <td style="padding:22px 32px 6px 32px;">
                <table role="presentation" cellpadding="0" cellspacing="0">
                  <tr>
                    {{#if orderUrl}}
                    <td style="padding-right:12px;padding-bottom:12px;">
                      <a href="{{orderUrl}}" style="display:inline-block;background:#ffffff;color:#000000;text-decoration:none;font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:700;padding:14px 22px;border-radius:2px;">
                        Ver pedido
                      </a>
                    </td>
                    {{/if}}

                    {{#if storeUrl}}
                    <td style="padding-bottom:12px;">
                      <a href="{{storeUrl}}" style="display:inline-block;color:#ffffff;text-decoration:none;font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:600;padding:14px 0;">
                        Visitar la tienda
                      </a>
                    </td>
                    {{/if}}
                  </tr>
                </table>
              </td>
            </tr>

            {{#if items}}
            <tr>
              <td style="padding:20px 32px 0 32px;">
                <div style="font-family:Arial,Helvetica,sans-serif;font-size:20px;line-height:1.3;color:#ffffff;font-weight:700;">
                  Artículos en este envío
                </div>
              </td>
            </tr>

            <tr>
              <td style="padding:14px 32px 0 32px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                  {{#each items}}
                  <tr>
                    <td style="padding:14px 0;border-bottom:1px solid #1a1a1a;" valign="top">
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                        <tr>
                          <td width="84" valign="top" style="padding-right:14px;">
                            {{#if imageUrl}}
                            <img
                              src="{{imageUrl}}"
                              alt="{{name}}"
                              width="70"
                              height="70"
                              style="display:block;width:70px;height:70px;object-fit:cover;border:1px solid #202020;border-radius:8px;background:#0d0d0d;"
                            />
                            {{else}}
                            <div style="width:70px;height:70px;border:1px solid #202020;border-radius:8px;background:#0d0d0d;"></div>
                            {{/if}}
                          </td>
                          <td valign="middle">
                            <div style="font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#ffffff;font-weight:600;">
                              {{name}}{{#if quantity}} × {{quantity}}{{/if}}
                            </div>
                            {{#if variantName}}
                            <div style="padding-top:2px;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:1.6;color:#9a9a9a;text-transform:uppercase;letter-spacing:0.04em;">
                              {{variantName}}
                            </div>
                            {{/if}}
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                  {{/each}}
                </table>
              </td>
            </tr>
            {{/if}}

            <tr>
              <td style="padding:24px 32px 0 32px;">
                <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.7;color:#d0d0d0;">
                  Te avisaremos de nuevo en cuanto el envío conste como entregado.
                </div>
              </td>
            </tr>

            <tr>
              <td style="padding:28px 32px 32px 32px;">
                <div style="height:1px;background:#1f1f1f;"></div>
                <div style="padding-top:18px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.7;color:#8a8a8a;">
                  Este es un correo automático de CRONOX. Si has recibido este mensaje, es porque tu pedido ha avanzado en el proceso logístico.
                </div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>