<!doctype html>
<html lang="es">
  <body style="margin:0;padding:0;background:#f3f3f1;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f3f1;padding:24px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px;background:#f7f7f5;border:1px solid #ebebe7;padding:28px;">
            <tr><td style="font-family:Georgia,'Times New Roman',serif;font-size:34px;font-weight:700;color:#000;">CRONOX</td></tr>
            <tr><td style="padding-top:12px;font-family:Arial,Helvetica,sans-serif;font-size:22px;color:#111;">Tu pedido ya está en camino ✧</td></tr>
            <tr><td style="padding-top:10px;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#5a5a5a;line-height:22px;">Pedido #{{orderId}} · Estado: {{statusLabel}}</td></tr>

            {{#if shippingCarrier}}
            <tr><td style="padding-top:10px;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#5a5a5a;">Transportista: <strong>{{shippingCarrier}}</strong></td></tr>
            {{/if}}
            {{#if trackingNumber}}
            <tr><td style="padding-top:6px;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#5a5a5a;">Seguimiento: <strong>{{trackingNumber}}</strong></td></tr>
            {{/if}}

            {{#if trackingUrl}}
            <tr>
              <td style="padding-top:18px;">
                <a href="{{trackingUrl}}" style="display:inline-block;background:#060606;color:#fff;text-decoration:none;font-family:Arial,Helvetica,sans-serif;font-size:13px;padding:14px 18px;border-radius:2px;">Seguir pedido</a>
              </td>
            </tr>
            {{/if}}

            <tr><td style="padding-top:16px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#8a8a8a;">Te avisaremos de nuevo cuando conste como entregado.</td></tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
