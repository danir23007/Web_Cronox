<!doctype html>
<html lang="es">
  <body style="margin:0;padding:0;background:#f3f3f1;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;background:#f3f3f1;margin:0;padding:0;">
      <tr>
        <td align="center" style="padding:24px 12px;">

          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:640px;border-collapse:collapse;background:#f3f3f1;">

            <!-- HERO BLOCK -->
            <tr>
              <td style="background:#f7f7f5;border:1px solid #ebebe7;padding:30px 26px 34px 26px;">

                <!-- HEADER -->
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
                  <tr>
                    <td valign="top" align="left" style="padding:0 12px 18px 0;">
                       <div style="font-family:Georgia,'Times New Roman',serif;font-size:34px;line-height:34px;font-weight:700;color:#000000;letter-spacing:0.3px;">
                        CRONOX
                      </div>
                    </td>

                    <td valign="top" align="right" style="padding:2px 0 18px 12px;">
                      <div style="font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:15px;color:#8c8c8c;text-transform:uppercase;letter-spacing:0.8px;">
                        Pedido n.º
                      </div>
                      <div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:16px;color:#777777;">
                        {{orderId}}
                      </div>
                    </td>
                  </tr>
                </table>

                <!-- TITLE -->
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
                  <tr>
                    <td style="padding:0 0 16px 0;">
                      <div style="font-family:Arial,Helvetica,sans-serif;font-size:17px;line-height:27px;color:#111111;font-weight:400;">
                        Gracias por visitar Cronox
                      </div>
                    </td>
                  </tr>
                </table>

                <!-- INTRO -->
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
                  <tr>
                    <td style="padding:0 0 12px 0;">
                      <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#6e6e6e;">
                        ¡Agradecemos que formes parte de esto! Tu paquete se está preparando y te llegará muy pronto. ☽
                      </div>
                    </td>
                  </tr>

                  <tr>
                    <td style="padding:0 0 14px 0;">
                      <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#6e6e6e;">
                        Te avisaremos cuando esté en camino. ✧
                      </div>
                    </td>
                  </tr>
                </table>

                <!-- CTA -->
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
                  <tr>
                    <td style="padding:0 14px 0 0;">
                      <a href="{{orderUrl}}" style="display:inline-block;background:#060606;color:#ffffff;text-decoration:none;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:13px;padding:16px 22px;border-radius:2px;">
                        Ver tu pedido
                      </a>
                    </td>

                    <td style="padding:0;">
                      <a href="{{storeUrl}}" style="display:inline-block;background:transparent;color:#111111;text-decoration:none;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:13px;padding:16px 0;">
                        o visita nuestra tienda
                      </a>
                    </td>
                  </tr>
                </table>

              </td>
            </tr>

            <!-- SPACE -->
            <tr>
              <td style="height:18px;line-height:18px;font-size:18px;">&nbsp;</td>
            </tr>

            <!-- ORDER SUMMARY -->
            <tr>
              <td style="background:#f7f7f5;border:1px solid #ebebe7;padding:30px 26px 24px 26px;">

                <div style="font-family:Arial,Helvetica,sans-serif;font-size:17px;line-height:24px;color:#111111;font-weight:400;padding:0 0 24px 0;">
                  Resumen del pedido
                </div>

                {{#each items}}
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
                  <tr>
                    <td valign="top" width="76" style="width:76px;padding:0 16px 20px 0;">
                      {{#if imageUrl}}
                      <img
                        src="{{imageUrl}}"
                        alt="{{name}}"
                        width="70"
                        style="display:block;width:70px;height:70px;border:1px solid #e1e1dd;border-radius:8px;object-fit:cover;background:#ffffff;"
                      />
                      {{else}}
                      <div style="width:70px;height:70px;border:1px solid #e1e1dd;border-radius:8px;background:#ffffff;"></div>
                      {{/if}}
                    </td>

                    <td valign="top" style="padding:0 12px 20px 0;">
                      <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;color:#4b4b4b;font-weight:600;">
                        {{name}}{{#if quantity}} × {{quantity}}{{/if}}
                      </div>

                      {{#if variantName}}
                      <div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#929292;text-transform:uppercase;padding-top:3px;">
                        {{variantName}}
                      </div>
                      {{/if}}
                    </td>

                    <td valign="top" align="right" style="padding:0 0 20px 0;white-space:nowrap;">
                      <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;color:#4b4b4b;font-weight:600;">
                        {{lineTotalFormatted}}
                      </div>
                    </td>
                  </tr>

                  <tr>
                    <td colspan="3" style="padding:0 0 18px 0;">
                      <div style="height:1px;line-height:1px;font-size:1px;background:#ddddda;">&nbsp;</div>
                    </td>
                  </tr>
                </table>
                {{/each}}

                <!-- TOTALS -->
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
                  <tr>
                    <td width="44%" style="width:44%;">&nbsp;</td>
                    <td width="56%" style="width:56%;padding:8px 0 0 0;">

                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">

                        <tr>
                          <td style="padding:0 0 8px 0;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:20px;color:#7a7a7a;">
                            Total parcial
                          </td>
                          <td align="right" style="padding:0 0 8px 0;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:20px;color:#4a4a4a;font-weight:600;">
                            {{subtotalFormatted}}
                          </td>
                        </tr>

                        {{#if savingsFormatted}}
                        <tr>
                          <td style="padding:0 0 8px 0;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:20px;color:#7a7a7a;">
                            Descuento
                          </td>
                          <td align="right" style="padding:0 0 8px 0;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:20px;color:#4a4a4a;font-weight:600;">
                            {{discountFormatted}}
                          </td>
                        </tr>
                        {{/if}}

                        <tr>
                          <td style="padding:0 0 8px 0;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:20px;color:#7a7a7a;">
                            Envío
                          </td>
                          <td align="right" style="padding:0 0 8px 0;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:20px;color:#4a4a4a;font-weight:600;">
                            {{shippingFormatted}}
                          </td>
                        </tr>

                        <tr>
                          <td style="padding:0 0 12px 0;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:20px;color:#7a7a7a;">
                            Impuestos
                          </td>
                          <td align="right" style="padding:0 0 12px 0;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:20px;color:#4a4a4a;font-weight:600;">
                            {{taxesFormatted}}
                          </td>
                        </tr>

                        <tr>
                          <td colspan="2" style="padding:0 0 14px 0;">
                            <div style="height:1px;line-height:1px;font-size:1px;background:#ddddda;">&nbsp;</div>
                          </td>
                        </tr>

                        <tr>
                          <td style="padding:0 0 4px 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#5a5a5a;">
                            Total
                          </td>
                          <td align="right" style="padding:0 0 4px 0;font-family:Arial,Helvetica,sans-serif;font-size:18px;line-height:24px;color:#3d3d3d;font-weight:700;">
                            {{totalFormatted}}
                          </td>
                        </tr>

                        {{#if savingsFormatted}}
                        <tr>
                          <td>&nbsp;</td>
                          <td align="right" style="padding:0;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#7a7a7a;">
                            Ahorraste {{savingsFormatted}}
                          </td>
                        </tr>
                        {{/if}}

                      </table>

                    </td>
                  </tr>
                </table>

              </td>
            </tr>

            <!-- SPACE -->
            <tr>
              <td style="height:18px;line-height:18px;font-size:18px;">&nbsp;</td>
            </tr>

            <!-- CUSTOMER INFO -->
            <tr>
              <td style="background:#f7f7f5;border:1px solid #ebebe7;padding:30px 26px 26px 26px;">

                <div style="font-family:Arial,Helvetica,sans-serif;font-size:18px;line-height:25px;color:#111111;font-weight:600;padding:0 0 26px 0;">
                  Información del cliente
                </div>

                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
                  <tr>
                    <!-- CUSTOMER CONTACT -->
                    <td valign="top" width="50%" style="width:50%;padding:0 18px 24px 0;">
                      <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#3f3f3f;font-weight:600;padding:0 0 10px 0;">
                        Contacto
                      </div>

                      {{#if customerFullName}}
                      <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#767676;">
                        {{customerFullName}}
                      </div>
                      {{/if}}

                      {{#if customerEmail}}
                      <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#767676;">
                        {{customerEmail}}
                      </div>
                      {{/if}}

                      {{#if customerPhone}}
                      <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#767676;">
                        {{customerPhone}}
                      </div>
                      {{/if}}
                    </td>

                    <!-- SHIPPING ADDRESS -->
                    <td valign="top" width="50%" style="width:50%;padding:0 0 24px 18px;">
                      <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#3f3f3f;font-weight:600;padding:0 0 10px 0;">
                        Dirección de envío
                      </div>

                      {{#if shippingAddress.fullName}}
                      <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#767676;">
                        {{shippingAddress.fullName}}
                      </div>
                      {{/if}}

                      {{#if shippingAddress.line1}}
                      <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#767676;">
                        {{shippingAddress.line1}}
                      </div>
                      {{/if}}

                      {{#if shippingAddress.line2}}
                      <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#767676;">
                        {{shippingAddress.line2}}
                      </div>
                      {{/if}}

                      {{#if shippingAddress.postalCode}}
                      <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#767676;">
                        {{shippingAddress.postalCode}}{{#if shippingAddress.city}}, {{shippingAddress.city}}{{/if}}
                      </div>
                      {{else}}
                        {{#if shippingAddress.city}}
                        <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#767676;">
                          {{shippingAddress.city}}
                        </div>
                        {{/if}}
                      {{/if}}

                      {{#if shippingAddress.state}}
                      <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#767676;">
                        {{shippingAddress.state}}
                      </div>
                      {{/if}}

                      {{#if shippingAddress.country}}
                      <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#767676;">
                        {{shippingAddress.country}}
                      </div>
                      {{/if}}
                    </td>
                  </tr>
                </table>

                <!-- SHIPPING METHOD -->
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
                  <tr>
                    <td style="padding:4px 0 0 0;">
                      <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#3f3f3f;font-weight:600;padding:0 0 10px 0;">
                        Método de envío
                      </div>

                      <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#767676;text-transform:uppercase;letter-spacing:0.2px;">
                        {{shippingMethod}}
                      </div>
                    </td>
                  </tr>
                </table>

              </td>
            </tr>

            <!-- FOOTER SPACE -->
            <tr>
              <td style="height:20px;line-height:20px;font-size:20px;">&nbsp;</td>
            </tr>

          </table>

        </td>
      </tr>
    </table>
  </body>
</html>
