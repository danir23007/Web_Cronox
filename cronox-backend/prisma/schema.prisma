generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id         Int               @id @default(autoincrement())
  slug       String            @unique
  name       String
  description String?
  price      Int
  currency   String            @default("EUR")
  imageUrl   String?
  isActive   Boolean           @default(true)
  collection String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  favorites  Favorite[]
  orderItems OrderItem[]
  categories ProductCategory[]
  images     ProductImage[]
  variants   ProductVariant[]
}

model Category {
  id          Int               @id @default(autoincrement())
  name        String
  slug        String            @unique
  description String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  products    ProductCategory[]
}

model ProductCategory {
  id         Int      @id @default(autoincrement())
  productId  Int
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
}

model ProductVariant {
  id        Int             @id @default(autoincrement())
  productId Int
  size      VariantSize
  sku       String          @unique
  price     Int?
  stockQty  Int             @default(0) @map("stock")
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  cartItems CartItem[]
  product   Product         @relation(fields: [productId], references: [id])
  movements StockMovement[]

  @@unique([productId, size])
  @@index([productId])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  url       String
  alt       String?  @default("")
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])

  @@index([productId, sortOrder])
}

model User {
  id                     Int                  @id @default(autoincrement())
  email                  String               @unique
  password               String               @map("passwordHash")
  role                   Role                 @default(USER)
  name                   String?
  firstName              String?
  lastName               String?
  memberCode             String?              @unique
  newsletterSubscribed   Boolean              @default(false)
  firstOrderDiscountCode String?
  firstOrderDiscountUsed Boolean              @default(false)
  circleLevel            Int                  @default(1)
  circlePromotionRequest CirclePromotionRequest?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  addresses              Address[]
  carts                  Cart?
  favorites              Favorite[]
  orders                 Order[]
  stockMovements         StockMovement[]
  passwordResetTokens    PasswordResetToken[]
  discountCodes          DiscountCode[]
  circleUpgradeRequests  CircleUpgradeRequest[]
  processedUpgrades      CircleUpgradeRequest[] @relation("ProcessedRequests")
  auditLogs              AuditLog[]

  // ✅ FIX: relación correcta y naming consistente
  historial              Historial?
}

model CirclePromotionRequest {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  status      String   @default("pending")
  requestedAt DateTime @default(now())
  promoteAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, promoteAt])
}

model CircleUpgradeRequest {
  id                 String                        @id @default(uuid())
  userId             Int
  fromCircle         Int                           @default(3)
  toCircle           Int                           @default(4)
  socialNetwork      CircleUpgradeSocialNetwork
  username           String
  usernameNormalized String
  status             CircleUpgradeRequestStatus    @default(PENDING)
  requestNumber      Int
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  reviewedAt         DateTime?
  reviewedBy         String?
  notes              String?
  approvedAt         DateTime?
  processedAt        DateTime?
  processedById      Int?
  autoProcessAt      DateTime?

  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  processedBy   User? @relation("ProcessedRequests", fields: [processedById], references: [id])

  @@unique([userId, requestNumber])
  @@index([status, socialNetwork, usernameNormalized])
  @@index([fromCircle, toCircle, status])
}

model Historial {
  // ✅ FIX: en DB debe ser Int autoincrement (antes tenías String cuid())
  id                  Int      @id @default(autoincrement())
  userId              Int      @unique
  pedidosRealizados   Int      @default(0)
  articulosAdquiridos Int      @default(0)
  devoluciones        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("historial")
}

model DiscountCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  type      String
  percent   Int
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  createdAt DateTime @default(now())
  usedAt    DateTime?

  @@index([userId])
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  phone     String?
  line1     String
  line2     String?
  city      String
  state     String?
  zip       String
  country   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
}

model Cart {
  id          Int        @id @default(autoincrement())
  userId      Int?       @unique
  anonymousId String?    @unique
  itemsCount  Int        @default(0)
  subtotal    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CartItem[]
}

model CartItem {
  id         Int            @id @default(autoincrement())
  cartId     Int
  variantId  Int
  qty        Int
  priceAtAdd Int
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  cart       Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Order {
  id                 Int              @id @default(autoincrement())
  status             OrderStatus      @default(PENDING)
  subtotal           Decimal          @db.Decimal(12, 2)
  taxRate            Decimal          @db.Decimal(5, 4)
  taxAmount          Decimal          @db.Decimal(12, 2)
  shippingCost       Int              @default(0)
  shippingMethodId   Int?
  shippingMethod     ShippingMethod?  @relation(fields: [shippingMethodId], references: [id])
  shippingMethodCode String?
  discountCents      Int              @default(0)
  promoCodeId        Int?
  promoCodeCode      String?
  total              Decimal          @db.Decimal(12, 2)
  currency           String           @default("EUR")
  provider           String?
  providerRef        String?          @unique
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  shippingAddr       Json?
  billingAddr        Json?
  userId             Int
  user               User             @relation(fields: [userId], references: [id])
  items              OrderItem[]
  stockMovements     StockMovement[]
  promoCode          PromoCode?       @relation(fields: [promoCodeId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  title     String
  unitPrice Decimal @db.Decimal(12, 2)
  quantity  Int
  lineTotal Decimal @db.Decimal(12, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model StockMovement {
  id        String         @id @default(cuid())
  variantId Int
  delta     Int
  reason    String?
  createdAt DateTime       @default(now())
  orderId   Int?
  userId    Int?
  order     Order?         @relation(fields: [orderId], references: [id])
  user      User?          @relation(fields: [userId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId])
  @@index([orderId])
  @@index([variantId, createdAt])
  @@index([userId])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?
}

model PromoCode {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  type         PromoCodeType
  value        Int
  minCartValue Int?
  startsAt     DateTime?
  expiresAt    DateTime?
  isActive     Boolean   @default(true)
  usageCount   Int       @default(0)
  usageLimit   Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  orders       Order[]
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
}

model ShippingMethod {
  id        Int      @id @default(autoincrement())
  /// Nombre legible tipo "Envío estándar" / "Envío express"
  name      String
  /// Precio base del envío EN CÉNTIMOS
  price     Int
  isActive  Boolean  @default(true)
  countries String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

enum Role {
  ADMIN
  USER
  SUPERADMIN
}

enum CircleUpgradeRequestStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

enum PromoCodeType {
  PERCENT
  FIXED
}

enum CircleUpgradeSocialNetwork {
  INSTAGRAM
  TIKTOK
  X
  FACEBOOK
  YOUTUBE
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
  SHIPPED
}

enum VariantSize {
  XS
  S
  M
  L
  XL
  XXL
}
