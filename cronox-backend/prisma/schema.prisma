// Aggregate history is independent of short-lived customer activity/session logs.
model VisitorHistoryConfig {
  id        Int      @id
  startedAt DateTime @db.Timestamptz(3)
  deduplicationStartedAt DateTime? @default(now()) @db.Timestamptz(3)
}

model DailyVisitor {
  browserLinks DailyVisitorLink[]
  disposition String @default("independent")
  observedRole String?
  id       String   @id
  day      DateTime @db.Date
  category String
  identity String
  userId   Int?
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstAt  DateTime @db.Timestamptz(3)
  lastAt   DateTime @db.Timestamptz(3)

