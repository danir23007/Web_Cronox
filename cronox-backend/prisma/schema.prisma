generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id             Int                     @id @default(autoincrement())
  slug           String                  @unique
  name           String
  description    String?
  price          Int
  currency       String                  @default("EUR")
  imageUrl       String?
  isActive       Boolean                 @default(true)
  collection     String?
  searchKeywords String[]                @default([])
  searchText     String                  @default("")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  favorites      Favorite[]
  orderItems     OrderItem[]
  categories     ProductCategory[]
  images         ProductImage[]
  variants       ProductVariant[]
  activityEvents CustomerActivityEvent[]
  galleryAssets  GalleryAssetProduct[]

  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_searchText_idx")
}

model Category {
  id          Int               @id @default(autoincrement())
  name        String
  slug        String            @unique
  description String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  products    ProductCategory[]
}

model ProductCategory {
  id         Int      @id @default(autoincrement())
  productId  Int
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
}

model ProductVariant {
  id                        Int                        @id @default(autoincrement())
  productId                 Int
  size                      VariantSize
  sku                       String                     @unique
  price                     Int?
  stockQty                  Int                        @default(0) @map("stock")
  isActive                  Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  cartItems                 CartItem[]
  product                   Product                    @relation(fields: [productId], references: [id])
  movements                 StockMovement[]
  checkoutStockReservations CheckoutStockReservation[]
  activityEvents            CustomerActivityEvent[]

  @@unique([productId, size])
  @@index([productId])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  url       String
  alt       String?  @default("")
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])

  @@index([productId, sortOrder])
}

model GalleryAsset {
  id               String                @id @default(cuid())
  storageKey       String                @unique
  publicUrl        String
  originalFilename String
  mimeType         String
  fileSize         Int
  width            Int?
  height           Int?
  description      String?               @db.Text
  createdAt        DateTime              @default(now())
  slots            GallerySlot[]
  products         GalleryAssetProduct[]

  @@index([createdAt])
}

model GalleryAssetProduct {
  id             Int          @id @default(autoincrement())
  galleryAssetId String
  productId      Int
  position       Int
  createdAt      DateTime     @default(now())
  galleryAsset   GalleryAsset @relation(fields: [galleryAssetId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([galleryAssetId, productId])
  @@unique([galleryAssetId, position])
  @@index([productId])
}

model GallerySlot {
  key              String                  @id
  displayOrder     Int                     @unique
  featured         Boolean                 @default(false)
  placeholderColor GalleryPlaceholderColor
  assetId          String?
  focalX           Float                   @default(50)
  focalY           Float                   @default(50)
  zoom             Float                   @default(1)
  fit              MediaFitMode            @default(COVER)
  tabletFocalX     Float?
  tabletFocalY     Float?
  tabletZoom       Float?
  tabletFit        MediaFitMode?
  mobileFocalX     Float?
  mobileFocalY     Float?
  mobileZoom       Float?
  mobileFit        MediaFitMode?
  revision         Int                     @default(0)
  altText          String                  @default("")
  instagramUrl     String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  asset            GalleryAsset?           @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([assetId])
}

model WebsiteMediaPlacement {
  key          String             @id
  assetId      String?
  focalX       Float
  focalY       Float
  zoom         Float
  fit          MediaFitMode
  tabletFocalX Float?
  tabletFocalY Float?
  tabletZoom   Float?
  tabletFit    MediaFitMode?
  mobileFocalX Float?
  mobileFocalY Float?
  mobileZoom   Float?
  mobileFit    MediaFitMode?
  revision     Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  asset        WebsiteMediaAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([assetId])
}

model WebsiteMediaAsset {
  id               String                  @id @default(cuid())
  storageKey       String                  @unique
  publicUrl        String
  originalFilename String
  mimeType         String
  mediaType        String
  folderKey        String
  fileSize         Int
  width            Int?
  height           Int?
  createdAt        DateTime                @default(now())
  placements       WebsiteMediaPlacement[]

  @@index([folderKey, mediaType, createdAt])
  @@index([createdAt])
}

model User {
  id                        Int                     @id @default(autoincrement())
  email                     String                  @unique
  password                  String?                 @map("passwordHash")
  passwordSetupEmailSentAt  DateTime?
  passwordSetupClaimedAt    DateTime?
  role                      Role                    @default(USER)
  name                      String?
  firstName                 String?
  lastName                  String?
  memberCode                String?                 @unique
  publicMemberToken         String?                 @unique
  sessionVersion            Int                     @default(0)
  newsletterSubscribed      Boolean                 @default(false)
  firstOrderDiscountCode    String?
  firstOrderDiscountUsed    Boolean                 @default(false)
  circleLevel               Int                     @default(1)
  circlePromotionRequest    CirclePromotionRequest?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  lastLoginAt               DateTime?
  analyticsConsentStatus    AnalyticsConsentStatus?
  analyticsConsentVersion   String?
  analyticsConsentDecidedAt DateTime?
  analyticsFirstGrantedAt   DateTime?
  analyticsLastGrantedAt    DateTime?
  addresses                 Address[]
  carts                     Cart?
  favorites                 Favorite[]
  orders                    Order[]
  promoCodeRedemptions      PromoCodeRedemption[]
  stockMovements            StockMovement[]
  passwordResetTokens       PasswordResetToken[]
  discountCodes             DiscountCode[]
  circleUpgradeRequests     CircleUpgradeRequest[]
  processedUpgrades         CircleUpgradeRequest[]  @relation("ProcessedRequests")
  auditLogs                 AuditLog[]
  adminNotes                AdminNote[]
  checkoutSnapshots         CheckoutSnapshot[]
  loginEvents               UserLoginEvent[]
  analyticsSessions         AnalyticsSession[]
  activityEvents            CustomerActivityEvent[]

  // ✅ FIX: relación correcta y naming consistente
  historial Historial?
}

model CirclePromotionRequest {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  status      String   @default("pending")
  requestedAt DateTime @default(now())
  promoteAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, promoteAt])
}

model CircleUpgradeRequest {
  id                 String                     @id @default(uuid())
  userId             Int
  fromCircle         Int                        @default(3)
  toCircle           Int                        @default(4)
  socialNetwork      CircleUpgradeSocialNetwork
  username           String
  usernameNormalized String
  status             CircleUpgradeRequestStatus @default(PENDING)
  requestNumber      Int
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  reviewedAt         DateTime?
  reviewedBy         String?
  notes              String?
  approvedAt         DateTime?
  processedAt        DateTime?
  processedById      Int?
  autoProcessAt      DateTime?

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  processedBy User? @relation("ProcessedRequests", fields: [processedById], references: [id])

  @@unique([userId, requestNumber])
  @@index([status, socialNetwork, usernameNormalized])
  @@index([fromCircle, toCircle, status])
}

model Historial {
  // ✅ FIX: en DB debe ser Int autoincrement (antes tenías String cuid())
  id                  Int      @id @default(autoincrement())
  userId              Int      @unique
  pedidosRealizados   Int      @default(0)
  articulosAdquiridos Int      @default(0)
  devoluciones        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("historial")
}

model DiscountCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  type      String
  percent   Int
  used      Boolean   @default(false)
  user      User      @relation(fields: [userId], references: [id])
  userId    Int
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  @@index([userId])
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  phone     String?
  line1     String
  line2     String?
  city      String
  state     String?
  zip       String
  country   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
}

model Cart {
  id          Int        @id @default(autoincrement())
  userId      Int?       @unique
  anonymousId String?    @unique
  itemsCount  Int        @default(0)
  subtotal    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CartItem[]
}

model CartItem {
  id         Int            @id @default(autoincrement())
  cartId     Int
  variantId  Int
  qty        Int
  priceAtAdd Int
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  cart       Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([variantId])
}

// A checkout snapshot is created before a Stripe PaymentIntent is created.
// Order creation must use these frozen values rather than a mutable cart.
model CheckoutSnapshot {
  id                         String                     @id @default(cuid())
  userId                     Int?
  anonymousId                String?
  customerEmail              String
  cartId                     Int
  cartUpdatedAt              DateTime
  requestFingerprint         String
  stripePaymentIntentId      String?                    @unique
  stripeAccountId            String?
  paymentRecoveryToken       String?
  paymentRecoveryClaimedAt   DateTime?
  status                     String                     @default("PENDING")
  currency                   String                     @default("EUR")
  subtotalCents              Int
  taxRate                    Decimal                    @db.Decimal(5, 4)
  taxAmountCents             Int
  shippingCostCents          Int                        @default(0)
  shippingMethodId           Int?
  shippingMethodCode         String?
  shippingMethodLabel        String?
  shippingMethodDescription  String?
  shippingMethodPriceCents   Int?
  discountCents              Int                        @default(0)
  disputeLostCents           Int                        @default(0)
  promoCodeId                Int?
  promoCodeCode              String?
  totalCents                 Int
  shippingAddr               Json?
  billingAddr                Json?
  confirmationEmailSentAt    DateTime?
  confirmationEmailClaimedAt DateTime?
  stockReturnedAt            DateTime?
  orderId                    Int?                       @unique
  expiresAt                  DateTime
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  user                       User?                      @relation(fields: [userId], references: [id])
  order                      Order?                     @relation("CheckoutSnapshotOrder", fields: [orderId], references: [id], onDelete: SetNull)
  items                      CheckoutSnapshotItem[]
  stockReservations          CheckoutStockReservation[]
  stockMovements             StockMovement[]
  activityEvents             CustomerActivityEvent[]

  @@index([userId, status])
  @@index([anonymousId, status])
  @@index([cartId])
  @@index([expiresAt])
  @@index([stripeAccountId, stripePaymentIntentId])
  @@index([userId, cartId, cartUpdatedAt, requestFingerprint])
}

model CheckoutSnapshotItem {
  id                 Int              @id @default(autoincrement())
  checkoutSnapshotId String
  productId          Int
  variantId          Int
  title              String
  unitPriceCents     Int
  quantity           Int
  lineTotalCents     Int
  checkoutSnapshot   CheckoutSnapshot @relation(fields: [checkoutSnapshotId], references: [id], onDelete: Cascade)

  @@index([checkoutSnapshotId])
  @@index([variantId])
}

// Inventory is reserved when a server-side checkout snapshot is created and
// either consumed by the resulting order or released after a safe cancellation.
model CheckoutStockReservation {
  id                 String           @id @default(cuid())
  checkoutSnapshotId String
  variantId          Int
  quantity           Int
  status             String           @default("RESERVED")
  releasedAt         DateTime?
  consumedAt         DateTime?
  returnedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  checkoutSnapshot   CheckoutSnapshot @relation(fields: [checkoutSnapshotId], references: [id], onDelete: Cascade)
  variant            ProductVariant   @relation(fields: [variantId], references: [id])

  @@unique([checkoutSnapshotId, variantId])
  @@index([variantId, status])
  @@index([checkoutSnapshotId, status])
}

// Stripe may deliver an event more than once and in a different order from
// related events. Store event identity and lifecycle state before acting on it.
model StripeWebhookEvent {
  id              String    @id
  type            String
  paymentIntentId String?
  lifecycleStatus String?
  amountCents     Int?
  status          String    @default("PROCESSING")
  error           String?
  occurredAt      DateTime
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([paymentIntentId, occurredAt])
  @@index([status, updatedAt])
}

model Order {
  id                   Int                     @id @default(autoincrement())
  status               OrderStatus             @default(PENDING)
  // Preserve fulfillment progress while a Stripe dispute is open. A later
  // reinstatement restores this state instead of downgrading a shipped or
  // delivered order back to PAID.
  preDisputeStatus     OrderStatus?
  trackingNumber       String?
  trackingUrl          String?
  shippingCarrier      String?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  internalNote         String?
  subtotal             Decimal                 @db.Decimal(12, 2)
  taxRate              Decimal                 @db.Decimal(5, 4)
  taxAmount            Decimal                 @db.Decimal(12, 2)
  shippingCost         Int                     @default(0)
  shippingMethodId     Int?
  shippingMethod       ShippingMethod?         @relation(fields: [shippingMethodId], references: [id])
  shippingMethodCode   String?
  discountCents        Int                     @default(0)
  disputeLostCents     Int                     @default(0)
  promoCodeId          Int?
  promoCodeCode        String?
  total                Decimal                 @db.Decimal(12, 2)
  currency             String                  @default("EUR")
  provider             String?
  providerRef          String?                 @unique
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  shippingAddr         Json?
  billingAddr          Json?
  customerEmail        String
  userId               Int?
  user                 User?                   @relation(fields: [userId], references: [id])
  items                OrderItem[]
  stockMovements       StockMovement[]
  promoCode            PromoCode?              @relation(fields: [promoCodeId], references: [id])
  promoCodeRedemptions PromoCodeRedemption[]
  checkoutSnapshot     CheckoutSnapshot?       @relation("CheckoutSnapshotOrder")
  activityEvents       CustomerActivityEvent[]

  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  title     String
  unitPrice Decimal @db.Decimal(12, 2)
  quantity  Int
  lineTotal Decimal @db.Decimal(12, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model StockMovement {
  id                 String            @id @default(cuid())
  variantId          Int
  delta              Int
  reason             String?
  createdAt          DateTime          @default(now())
  orderId            Int?
  userId             Int?
  checkoutSnapshotId String?
  order              Order?            @relation(fields: [orderId], references: [id])
  user               User?             @relation(fields: [userId], references: [id])
  variant            ProductVariant    @relation(fields: [variantId], references: [id])
  checkoutSnapshot   CheckoutSnapshot? @relation(fields: [checkoutSnapshotId], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@index([orderId])
  @@index([variantId, createdAt])
  @@index([userId])
  @@index([checkoutSnapshotId])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
}

model NewsletterSubscription {
  id                    String    @id @default(cuid())
  email                 String    @unique
  verificationTokenHash String?   @unique
  verificationExpiresAt DateTime?
  verifiedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([verifiedAt])
}

model PromoCode {
  id                   Int                   @id @default(autoincrement())
  code                 String                @unique
  type                 PromoCodeType
  value                Int
  minCartValue         Int?
  startsAt             DateTime?
  expiresAt            DateTime?
  isActive             Boolean               @default(true)
  usageCount           Int                   @default(0)
  usageLimit           Int?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  orders               Order[]
  promoCodeRedemptions PromoCodeRedemption[]
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  action     String?
  actionType String?
  targetType String?
  targetId   String?
  fromCircle Int?
  toCircle   Int?
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@index([actionType])
  @@index([targetType])
  @@index([targetId])
  @@index([actorId, createdAt])
  @@index([actionType, targetType, createdAt])
  @@index([targetType, targetId])
}

model ShippingMethod {
  id        Int      @id @default(autoincrement())
  /// Nombre legible tipo "Envío estándar" / "Envío express"
  name      String
  /// Precio base del envío EN CÉNTIMOS
  price     Int
  isActive  Boolean  @default(true)
  countries String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model PromoCodeRedemption {
  id          Int      @id @default(autoincrement())
  promoCodeId Int
  userId      Int
  orderId     Int
  redeemedAt  DateTime @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, userId])
  @@index([userId])
  @@index([orderId])
}

model AdminNote {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  authorAdminId Int
  targetType    String
  targetId      String
  content       String   @db.Text
  isDeleted     Boolean  @default(false)

  author User @relation(fields: [authorAdminId], references: [id])

  @@index([authorAdminId])
  @@index([targetType, targetId])
}

/// Security/account access history. Deliberately stores coarse parsed client
/// properties only: never raw IP addresses, raw User-Agent strings or IDs that
/// could be combined into a fingerprint.
model UserLoginEvent {
  id                  String      @id @default(cuid())
  userId              Int
  browserFamily       String      @db.VarChar(40)
  browserMajorVersion String?     @db.VarChar(12)
  osFamily            String      @db.VarChar(40)
  deviceClass         DeviceClass
  createdAt           DateTime    @default(now())
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// A visit is an analytics session, not a page view. The browser-provided UUID
/// is scoped to the authenticated account and contains no identifying data.
model AnalyticsSession {
  id             String                  @id @db.Uuid
  userId         Int
  startedAt      DateTime                @default(now())
  lastActivityAt DateTime                @default(now())
  activeSeconds  Int                     @default(0)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  events         CustomerActivityEvent[]

  @@index([userId, startedAt])
  @@index([userId, lastActivityAt])
  @@index([lastActivityAt])
}

/// Strictly structured behaviour events. There is intentionally no JSON
/// metadata column: every accepted field is bounded and purpose-specific.
model CustomerActivityEvent {
  id                 String                    @id @default(cuid())
  userId             Int
  sessionId          String                    @db.Uuid
  eventType          CustomerActivityEventType
  clientEventId      String?                   @unique @db.Uuid
  productId          Int?
  variantId          Int?
  categorySlug       String?                   @db.VarChar(80)
  searchQuery        String?                   @db.VarChar(80)
  resultCount        Int?
  quantity           Int?
  previousQuantity   Int?
  activeSeconds      Int?
  checkoutSnapshotId String?
  orderId            Int?
  createdAt          DateTime                  @default(now())
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  session            AnalyticsSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product            Product?                  @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant            ProductVariant?           @relation(fields: [variantId], references: [id], onDelete: SetNull)
  checkoutSnapshot   CheckoutSnapshot?         @relation(fields: [checkoutSnapshotId], references: [id], onDelete: SetNull)
  order              Order?                    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([eventType, checkoutSnapshotId])
  @@index([userId, createdAt])
  @@index([userId, eventType, createdAt])
  @@index([sessionId, createdAt])
  @@index([userId, productId, eventType])
  @@index([createdAt])
}

enum Role {
  USER
  SUPER_ADMIN
  MODERATOR
  LOGISTICS
  MARKETING
  ADMIN
  SUPERADMIN
}

enum CircleUpgradeRequestStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

enum PromoCodeType {
  PERCENT
  FIXED
}

enum CircleUpgradeSocialNetwork {
  INSTAGRAM
  TIKTOK
  X
  FACEBOOK
  YOUTUBE
}

enum OrderStatus {
  PENDING
  PAID
  DISPUTED
  PROCESSING
  DELIVERED
  CANCELLED
  REFUNDED
  SHIPPED
}

enum VariantSize {
  XS
  S
  M
  L
  XL
  XXL
}

enum AnalyticsConsentStatus {
  ACTIVE
  REJECTED
  WITHDRAWN
}

enum DeviceClass {
  DESKTOP
  MOBILE
  TABLET
  OTHER
}

enum CustomerActivityEventType {
  PRODUCT_VIEWED
  PRODUCT_ADDED_TO_CART
  PRODUCT_REMOVED_FROM_CART
  CART_QUANTITY_CHANGED
  FAVOURITE_ADDED
  FAVOURITE_REMOVED
  SEARCH_PERFORMED
  CATEGORY_VIEWED
  CHECKOUT_STARTED
  CHECKOUT_COMPLETED
  CHECKOUT_ABANDONED
  ACTIVE_TIME
}

enum GalleryPlaceholderColor {
  WHITE
  RED
  GREY
}

enum MediaFitMode {
  COVER
  CONTAIN
}
