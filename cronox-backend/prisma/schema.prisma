generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Private IMAP cache and mailbox client. Independent of transactional mail and permanent statistics.
model Mailbox {
  id            String              @id @default(uuid())
  name          String
  address       String              @unique
  fromName      String
  provider      String
  imapHost      String
  imapPort      Int                 @default(993)
  smtpHost      String
  smtpPort      Int                 @default(465)
  username      String
  imapSecretRef String?
  smtpSecretRef String?
  imapSecret    String?             @db.Text
  smtpSecret    String?             @db.Text
  active        Boolean             @default(false)
  notify        Boolean             @default(true)
  sentCopy      String              @default("append")
  status        String              @default("PENDING_CONFIG")
  errorCode     String?
  activatedAt   DateTime?
  lastSyncAt    DateTime?
  nextSyncAt    DateTime            @default(now())
  failures      Int                 @default(0)
  leaseToken    String?
  leaseUntil    DateTime?
  revision      Int                 @default(1)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  folders       MailboxFolder[]
  messages      MailboxMessage[]
  permissions   MailboxPermission[]
  drafts        MailboxDraft[]
  files         MailboxFile[]
  notices       MailboxNotice[]

  @@index([active, nextSyncAt])
}

model MailboxPermission {
  mailboxId String
  mailbox   Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  userId    Int
  access    String  @default("read")
  notify    Boolean @default(true)
  details   Boolean @default(false)

  @@id([mailboxId, userId])
  @@index([userId])
}

model MailboxFolder {
  notificationSince DateTime?
  id            String           @id @default(uuid())
  mailboxId     String
  mailbox       Mailbox          @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  path          String
  specialUse    String?
  available     Boolean          @default(true)
  uidValidity   String           @default("")
  lastUid       BigInt              @default(0)
  importBefore  BigInt              @default(0)
  reconcileUid  BigInt              @default(0)
  messagesCount Int              @default(0)
  unseenCount   Int              @default(0)
  updatedAt     DateTime         @updatedAt
  messages      MailboxMessage[]

  @@unique([mailboxId, path])
}

model MailboxMessage {
  id             String          @id @default(uuid())
  mailboxId      String
  mailbox        Mailbox         @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  folderId       String
  folder         MailboxFolder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  uidValidity    String
  uid            BigInt
  messageId      String?
  subject        String
  sender         String
  recipients     String
  envelope       Json
  preview        String          @default("")
  date           DateTime
  size           Int
  flags          String[]        @default([])
  seen           Boolean         @default(false)
  hasAttachments Boolean         @default(false)
  alive          Boolean         @default(true)
  bodyKey        String?
  bodyState      String          @default("NOT_LOADED")
  createdAt      DateTime        @default(now())
  files          MailboxFile[]
  notices        MailboxNotice[]

  @@unique([folderId, uidValidity, uid])
  @@index([mailboxId, alive, date, id])
  @@index([folderId, alive, seen, date, id])
  @@index([folderId, uidValidity, uid])
}

model MailboxDraft {
  mode       String        @default("individual")
  html       String        @default("") @db.Text
  templateId String?
  circles    Int[]         @default([])
  campaigns  MailboxCampaign[]
  id         String        @id @default(uuid())
  mailboxId  String
  mailbox    Mailbox       @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  userId     Int
  to         String        @default("")
  cc         String        @default("")
  bcc        String        @default("")
  subject    String        @default("")
  text       String        @default("") @db.Text
  inReplyTo  String?
  references String[]      @default([])
  revision   Int           @default(1)
  status     String        @default("DRAFT")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  files      MailboxFile[]
  sends      MailboxSend[]

  @@index([userId, mailboxId, updatedAt])
}

// Explicit, consent-filtered campaigns. Recipient snapshots are private API data.
model MailboxCampaign {
  errorCode String?
  id             String   @id @default(uuid())
  draftId        String
  draft          MailboxDraft @relation(fields: [draftId], references: [id], onDelete: Restrict)
  draftRevision  Int
  requestKey     String   @unique
  status         String   @default("SCHEDULED")
  scheduledAt    DateTime @db.Timestamptz(3)
  startedAt      DateTime? @db.Timestamptz(3)
  completedAt    DateTime? @db.Timestamptz(3)
  cancelledAt    DateTime? @db.Timestamptz(3)
  snapshot       Json
  deliveries     MailboxCampaignDelivery[]
  createdAt      DateTime @default(now())
  @@unique([draftId, draftRevision])
  @@index([status, scheduledAt])
}

model MailboxCampaignDelivery {
  id           String   @id @default(uuid())
  campaignId   String
  campaign     MailboxCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  email        String
  status       String   @default("PENDING")
  messageId    String   @unique
  attempts     Int      @default(0)
  readyAt      DateTime @default(now()) @db.Timestamptz(3)
  startedAt    DateTime? @db.Timestamptz(3)
  completedAt  DateTime? @db.Timestamptz(3)
  errorCode    String?
  sentCopyStatus String @default("NOT_ATTEMPTED")
  @@unique([campaignId, email])
  @@index([status, readyAt])
}

model MailboxCampaignClock {
  id        String @id
  nextAt    DateTime @db.Timestamptz(3)
}

model MailboxSuppression {
  email     String @id
  reason    String
  createdAt DateTime @default(now())
}

model MailboxSend {
  id             String       @id @default(uuid())
  draftId        String
  draft          MailboxDraft @relation(fields: [draftId], references: [id], onDelete: Restrict)
  draftRevision  Int
  userId         Int
  sessionId      String
  sessionVersion Int
  status         String       @default("PENDING")
  messageId      String       @unique
  requestKey     String       @unique
  errorCode      String?
  sentCopyStatus String       @default("NOT_ATTEMPTED")
  accepted       String[]     @default([])
  rejected       String[]     @default([])
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())

  @@unique([draftId, draftRevision])
  @@index([status, createdAt])
}

model MailboxFile {
  id        String          @id @default(uuid())
  mailboxId String
  mailbox   Mailbox         @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  messageId String?
  message   MailboxMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  draftId   String?
  draft     MailboxDraft?   @relation(fields: [draftId], references: [id], onDelete: Cascade)
  name      String
  mimeType  String
  size      Int
  key       String? @unique
  imapPart String?
  createdAt DateTime        @default(now())

  @@index([messageId])
  @@index([draftId])
}

model MailboxNotice {
  id        String         @id @default(uuid())
  mailboxId String
  mailbox   Mailbox        @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  messageId String         @unique
  message   MailboxMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@index([createdAt, id])
}

model MailboxPushDevice {
  mailEnabled Boolean @default(true)
  paidOrdersSince DateTime? @db.Timestamptz(3)
  visitsSince DateTime? @db.Timestamptz(3)
  waitlistSince DateTime? @db.Timestamptz(3)
  preferenceRevision Int @default(1)
  id             String    @id @default(uuid())
  userId         Int
  sessionId      String
  sessionVersion Int
  endpointHash   String    @unique
  subscription   String    @db.Text
  name           String
  active         Boolean   @default(true)
  mailboxIds     String[]  @default([])
  details        Boolean   @default(false)
  cursorAt       DateTime  @default(now())
  nextPushAt     DateTime  @default(now())
  failures       Int       @default(0)
  leaseUntil     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([active, nextPushAt])
  @@index([userId, sessionId])
}

model MailboxPushEvent {
  id String @id
  kind String
  payload Json
  occurredAt DateTime @db.Timestamptz(3)
  deliveries MailboxPushDelivery[]
}

model MailboxPushDelivery {
  eventId String
  event MailboxPushEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  deviceId String
  enabledSince DateTime @db.Timestamptz(3)
  status String @default("PENDING")
  attempts Int @default(0)
  readyAt DateTime @default(now()) @db.Timestamptz(3)
  startedAt DateTime? @db.Timestamptz(3)
  errorCode String?
  @@id([eventId, deviceId])
  @@index([deviceId, status, readyAt])
}

model MailboxAudit {
  id        String   @id @default(uuid())
  userId    Int?
  mailboxId String?
  action    String
  objectId  String?
  outcome   String
  createdAt DateTime @default(now())

  @@index([mailboxId, createdAt])
}

model EmailSenderProfile {
  key                String                 @id
  initializedAt      DateTime?
  defaultSignatureId String?                @unique
  defaultSignature   EmailSignature?        @relation("DefaultMailSignature", fields: [defaultSignatureId], references: [id], onDelete: SetNull)
  folders            EmailTemplateFolder[]
  templates          ManagedEmailTemplate[]
  signatures         EmailSignature[]       @relation("MailSignatures")
  assets             EmailAsset[]
  publications       EmailPublication[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
}

model EmailTemplateFolder {
  id        String                 @id @default(cuid())
  senderKey String
  sender    EmailSenderProfile     @relation(fields: [senderKey], references: [key], onDelete: Restrict)
  name      String
  position  Int                    @default(0)
  templates ManagedEmailTemplate[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@unique([senderKey, name])
  @@unique([id, senderKey])
  @@index([senderKey, position])
}

model ManagedEmailTemplate {
  id            String                 @id @default(cuid())
  senderKey     String
  sender        EmailSenderProfile     @relation(fields: [senderKey], references: [key], onDelete: Restrict)
  folderId      String
  folder        EmailTemplateFolder    @relation(fields: [folderId, senderKey], references: [id, senderKey], onDelete: Restrict)
  importKey     String?                @unique
  name          String
  purpose       String?
  subject       String
  preheader     String                 @default("")
  document      Json
  html          String                 @db.Text
  text          String                 @db.Text
  signatureMode String                 @default("none")
  signatureId   String?
  signature     EmailSignature?        @relation(fields: [signatureId], references: [id], onDelete: Restrict)
  revision      Int                    @default(1)
  archivedAt    DateTime?
  createdBy     Int?
  updatedBy     Int?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  versions      EmailTemplateVersion[]

  @@index([senderKey, folderId, archivedAt, updatedAt])
  @@index([senderKey, name])
}

model EmailTemplateVersion {
  id           String               @id @default(cuid())
  templateId   String
  template     ManagedEmailTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  snapshot     Json
  createdBy    Int?
  createdAt    DateTime             @default(now())
  publications EmailPublication[]

  @@index([templateId, createdAt])
}

model EmailPublication {
  senderKey String
  purpose   String
  sender    EmailSenderProfile   @relation(fields: [senderKey], references: [key], onDelete: Restrict)
  versionId String
  version   EmailTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  updatedAt DateTime             @updatedAt

  @@id([senderKey, purpose])
}

model EmailSignature {
  id         String                 @id @default(cuid())
  senderKey  String
  sender     EmailSenderProfile     @relation("MailSignatures", fields: [senderKey], references: [key], onDelete: Restrict)
  defaultFor EmailSenderProfile?    @relation("DefaultMailSignature")
  name       String
  document   Json
  revision   Int                    @default(1)
  archivedAt DateTime?
  createdBy  Int?
  updatedBy  Int?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  templates  ManagedEmailTemplate[]

  @@index([senderKey, archivedAt])
}

model EmailAsset {
  id         String             @id @default(cuid())
  senderKey  String
  sender     EmailSenderProfile @relation(fields: [senderKey], references: [key], onDelete: Restrict)
  url        String
  storageKey String             @unique
  name       String
  alt        String
  mimeType   String
  fileSize   Int
  width      Int
  height     Int
  createdBy  Int?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([senderKey, createdAt])
}

model EmailDelivery {
  id                String   @id @default(cuid())
  senderKey         String
  recipient         String
  subject           String
  purpose           String?
  status            String   @default("PENDING")
  providerMessageId String?
  errorCode         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([createdAt, id])
  @@index([senderKey, createdAt])
}

model Product {
  privateCost        ProductCost?
  id                 Int                        @id @default(autoincrement())
  slug               String                     @unique
  name               String
  description        String?
  price              Int
  currency           String                     @default("EUR")
  imageUrl           String?
  isActive           Boolean                    @default(true)
  displayOrder       Int                        @default(0)
  collection         String?
  searchKeywords     String[]                   @default([])
  searchText         String                     @default("")
  cardImagePositionX Float                      @default(50)
  cardImagePositionY Float                      @default(50)
  cardImageZoom      Float                      @default(1)
  sizeSystem         ProductSizeSystem          @default(APPAREL)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  favorites          Favorite[]
  orderItems         OrderItem[]
  categories         ProductCategory[]
  images             ProductImage[]
  variants           ProductVariant[]
  activityEvents     CustomerActivityEvent[]
  galleryAssets      GalleryAssetProduct[]
  adminCreateRequest AdminProductCreateRequest?

  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_searchText_idx")
  @@index([displayOrder, id])
}

/// Makes administrative product creation safe to retry without creating a
/// second product. The payload hash prevents reusing a key for different data.
model AdminProductCreateRequest {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique @db.VarChar(100)
  requestHash    String   @db.VarChar(64)
  productId      Int?     @unique
  createdAt      DateTime @default(now())
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model AdminBulkOperation {
  id          String   @id @db.Uuid
  actorId     Int
  requestHash String   @db.VarChar(64)
  result      Json
  createdAt   DateTime @default(now())

  @@index([actorId, createdAt])
}

model Category {
  id          Int               @id @default(autoincrement())
  name        String
  slug        String            @unique
  description String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  products    ProductCategory[]
}

model ProductCategory {
  id         Int      @id @default(autoincrement())
  productId  Int
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
}

model ProductVariant {
  restockRequests           RestockRequest[]
  id                        Int                        @id @default(autoincrement())
  productId                 Int
  size                      VariantSize
  sku                       String                     @unique
  price                     Int?
  stockQty                  Int                        @default(0) @map("stock")
  isActive                  Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  cartItems                 CartItem[]
  product                   Product                    @relation(fields: [productId], references: [id])
  movements                 StockMovement[]
  orderItems                OrderItem[]
  checkoutStockReservations CheckoutStockReservation[]
  activityEvents            CustomerActivityEvent[]

  @@unique([productId, size])
  @@index([productId])
}

model ProductImage {
  id               Int       @id @default(autoincrement())
  productId        Int
  url              String
  storageKey       String?
  mimeType         String?
  fileSize         Int?
  width            Int?
  height           Int?
  variants         Json?
  alt              String?   @default("")
  sortOrder        Int       @default(0)
  isPrimary        Boolean   @default(false)
  isActive         Boolean   @default(true)
  galleryPositionX Float     @default(50)
  galleryPositionY Float     @default(50)
  galleryZoom      Float     @default(1)
  galleryFit       String    @default("CONTAIN")
  archivedAt       DateTime?
  deletionState    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  product          Product   @relation(fields: [productId], references: [id])

  @@index([productId, sortOrder])
  @@index([productId, isActive, sortOrder])
  @@index([url])
}

model GalleryAsset {
  id               String                @id @default(cuid())
  storageKey       String                @unique
  publicUrl        String
  originalFilename String
  mimeType         String
  fileSize         Int
  width            Int?
  height           Int?
  variants         Json?
  description      String?               @db.Text
  createdAt        DateTime              @default(now())
  slots            GallerySlot[]
  carouselSlots    GalleryCarouselSlot[]
  products         GalleryAssetProduct[]

  @@index([createdAt])
}

model GallerySettings {
  id         String                  @id @default("global")
  activeMode GalleryPresentationMode @default(MOSAIC)
  revision   Int                     @default(0)
  updatedBy  Int?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
}

model FooterSettings {
  id                   String   @id @default("global")
  supportTitle         String   @default("SOPORTE")
  supportFaqLabel      String   @default("FAQS")
  supportShippingLabel String   @default("POLÍTICA DE ENVÍOS")
  supportReturnsLabel  String   @default("DEVOLUCIONES Y CAMBIOS")
  collabTitle          String   @default("COLABORA")
  collabDevelopLabel   String   @default("DESARROLLA")
  collabEventsLabel    String   @default("EVENTOS")
  legalTitle           String   @default("LEGAL")
  legalPrivacyLabel    String   @default("POLÍTICA DE PRIVACIDAD")
  legalCookiesLabel    String   @default("POLÍTICA DE COOKIES")
  legalTermsLabel      String   @default("TÉRMINOS DE SERVICIO")
  legalNoticeLabel     String   @default("AVISO LEGAL")
  instagramUrl         String   @default("https://www.instagram.com/cronox.es/")
  tiktokUrl            String   @default("https://tiktok.com/@tu_cuenta")
  youtubeUrl           String   @default("https://youtube.com/@tu_cuenta")
  revision             Int      @default(0)
  updatedBy            Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model FooterPageContent {
  slug      String   @id
  html      String   @db.Text
  revision  Int      @default(0)
  updatedBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryCarouselSlot {
  position          Int           @id
  assetId           String?
  itemId            String?       @unique
  description       String?       @db.Text
  relatedProductIds Json?
  focalX            Float         @default(50)
  focalY            Float         @default(50)
  zoom              Float         @default(1)
  fit               MediaFitMode  @default(COVER)
  tabletFocalX      Float?
  tabletFocalY      Float?
  tabletZoom        Float?
  tabletFit         MediaFitMode?
  mobileFocalX      Float?
  mobileFocalY      Float?
  mobileZoom        Float?
  mobileFit         MediaFitMode?
  revision          Int           @default(0)
  altText           String        @default("")
  instagramUrl      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  asset             GalleryAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([assetId])
}

model GalleryAssetProduct {
  id             Int          @id @default(autoincrement())
  galleryAssetId String
  productId      Int
  position       Int
  createdAt      DateTime     @default(now())
  galleryAsset   GalleryAsset @relation(fields: [galleryAssetId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([galleryAssetId, productId])
  @@unique([galleryAssetId, position])
  @@index([productId])
}

model GallerySlot {
  key              String                  @id
  displayOrder     Int                     @unique
  featured         Boolean                 @default(false)
  placeholderColor GalleryPlaceholderColor
  assetId          String?
  focalX           Float                   @default(50)
  focalY           Float                   @default(50)
  zoom             Float                   @default(1)
  fit              MediaFitMode            @default(COVER)
  tabletFocalX     Float?
  tabletFocalY     Float?
  tabletZoom       Float?
  tabletFit        MediaFitMode?
  mobileFocalX     Float?
  mobileFocalY     Float?
  mobileZoom       Float?
  mobileFit        MediaFitMode?
  revision         Int                     @default(0)
  altText          String                  @default("")
  instagramUrl     String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  asset            GalleryAsset?           @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([assetId])
}

model WebsiteMediaPlacement {
  key                         String             @id
  assetId                     String?
  focalX                      Float
  focalY                      Float
  zoom                        Float
  fit                         MediaFitMode
  tabletFocalX                Float?
  tabletFocalY                Float?
  tabletZoom                  Float?
  tabletFit                   MediaFitMode?
  mobileFocalX                Float?
  mobileFocalY                Float?
  mobileZoom                  Float?
  mobileFit                   MediaFitMode?
  heroText                    String?
  heroTextEnabled             Boolean            @default(false)
  heroTextX                   Float              @default(50)
  heroTextY                   Float              @default(50)
  heroTextTabletX             Float              @default(50)
  heroTextTabletY             Float              @default(50)
  heroTextTabletAlign         String             @default("CENTER")
  heroTextTabletColor         String             @default("#ffffff")
  heroTextTabletFontSize      Int                @default(42)
  heroTextTabletFontWeight    Int                @default(800)
  heroTextTabletLetterSpacing Float              @default(1.5)
  heroTextTabletUppercase     Boolean            @default(false)
  heroTextTabletMaxWidth      Int                @default(90)
  heroTextMobileX             Float              @default(50)
  heroTextMobileY             Float              @default(50)
  heroTextMobileAlign         String             @default("CENTER")
  heroTextMobileColor         String             @default("#ffffff")
  heroTextAlign               String             @default("CENTER")
  heroTextColor               String             @default("#ffffff")
  heroTextFontSize            Int                @default(42)
  heroTextMobileFontSize      Int                @default(30)
  heroTextMobileFontWeight    Int                @default(800)
  heroTextMobileLetterSpacing Float              @default(1.5)
  heroTextMobileUppercase     Boolean            @default(false)
  heroTextMobileMaxWidth      Int                @default(90)
  heroTextFontWeight          Int                @default(800)
  heroTextLetterSpacing       Float              @default(1.5)
  heroTextUppercase           Boolean            @default(false)
  heroTextMaxWidth            Int                @default(90)
  revision                    Int                @default(0)
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  asset                       WebsiteMediaAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([assetId])
}

model WebsiteMediaAsset {
  id                 String                  @id @default(cuid())
  storageKey         String                  @unique
  publicUrl          String
  originalFilename   String
  mimeType           String
  mediaType          String
  folderKey          String
  fileSize           Int
  width              Int?
  height             Int?
  variants           Json?
  createdAt          DateTime                @default(now())
  placements         WebsiteMediaPlacement[]
  keyScreens         KeyScreen[]
  newsletterSettings NewsletterSettings[]

  @@index([folderKey, mediaType, createdAt])
  @@index([createdAt])
}

model NewsletterSettings {
  id                String             @id @default("global")
  mediaAssetId      String?
  desktopFocalX     Float              @default(50)
  desktopFocalY     Float              @default(50)
  desktopZoom       Float              @default(1)
  desktopFit        MediaFitMode       @default(COVER)
  mobileFocalX      Float              @default(50)
  mobileFocalY      Float              @default(50)
  mobileZoom        Float              @default(1)
  mobileFit         MediaFitMode       @default(COVER)
  mediaOpacity      Float              @default(1)
  asciiEnabled      Boolean            @default(true)
  asciiOpacity      Float              @default(1)
  desktopAsciiX     Float              @default(50)
  desktopAsciiY     Float              @default(50)
