  @@index([day, category, firstAt, id])
  @@index([day, firstAt, id])
  @@index([userId])
}

model DailyVisitorBrowser {
  links DailyVisitorLink[]
  id String @id
  day DateTime @db.Date
  proofHash String
  visited Boolean @default(false)
  linked Boolean @default(false)
  adminExcluded Boolean @default(false)
  @@unique([day, proofHash])
}

model DailyVisitorLink {
  browser DailyVisitorBrowser @relation(fields: [browserId], references: [id], onDelete: Restrict)
  visitor DailyVisitor @relation(fields: [visitorId], references: [id], onDelete: Restrict)
  browserId String
  visitorId String
  @@id([browserId, visitorId])
}

// No FK to live business entities; payloads deliberately exclude personal fields.
model FinanceArchive {
  orderId    Int      @id
  currency   String
  paidDate   DateTime @db.Date
  lastDate   DateTime @db.Date
  uncertain  Boolean  @default(false)
  providerRef String? @unique
  snapshot   Json
  revision   Int      @default(1)

  @@index([currency, paidDate, orderId])
  @@index([currency, lastDate, orderId])
  @@index([currency, orderId])
}

model FinanceArchiveRevision {
  orderId    Int
  revision   Int
  snapshot   Json
  recordedAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([orderId, revision])
}

model FinanceEventArchive {
  id              String   @id
  paymentIntentId String?
  occurredAt      DateTime  @db.Timestamp(3)
  snapshot        Json

  @@index([paymentIntentId, occurredAt])
}

model FinanceStockArchive {
  id        String   @id
  orderId   Int
  createdAt DateTime @db.Timestamp(3)
  snapshot  Json

  @@index([orderId, createdAt])
}

model AuthSession {
  id                  String    @id
  userId              Int
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionVersion      Int
  lastActivityAt      DateTime  @default(now())
  createdAt           DateTime  @default(now())
  revokedAt           DateTime?
  refreshHash         String
  previousRefreshHash String?
  previousValidUntil  DateTime?
  generation          Int       @default(0)
  refreshIssuedAt     Int

  @@index([userId])
  @@index([lastActivityAt])
}

model KeyScreenSettings {
  id                String     @id @default("global")
  enabled           Boolean    @default(false)
  expiresAt         DateTime?  @db.Timestamptz(3)
  activeScreenId    String?    @unique
