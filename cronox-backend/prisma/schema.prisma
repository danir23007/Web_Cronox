  updatedBy         Int?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  launchStatus      String     @default("PENDING")
  launchArmedAt     DateTime?  @db.Timestamptz(3)
  launchStartedAt   DateTime?  @db.Timestamptz(3)
  launchCompletedAt DateTime?  @db.Timestamptz(3)
  launchTrigger     String?
  launchErrorCode   String?
}

model KeyScreen {
  id                     String                   @id @default(cuid())
  internalName           String
  mode                   KeyScreenMode            @default(PREREGISTRATION)
  mediaAssetId           String?
  mediaAsset             WebsiteMediaAsset?       @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  desktopFocalX          Float                    @default(50)
  desktopFocalY          Float                    @default(50)
  desktopZoom            Float                    @default(1)
  desktopFit             MediaFitMode             @default(COVER)
  mobileFocalX           Float?
  mobileFocalY           Float?
  mobileZoom             Float?
  mobileFit              MediaFitMode?
  title                  String                   @default("PRÓXIMAMENTE")
  subtitle               String                   @default("")
  placeholder            String                   @default("Correo electrónico")
  buttonText             String                   @default("NOTIFICARME")
  successTitle           String                   @default("YA FORMAS PARTE.")
  successMessage         String                   @default("Si el correo es válido, ya formas parte.")
  privacyLabel           String                   @default("Política de privacidad")
  textColor              String                   @default("#ffffff")
  inputStyle             KeyScreenControlStyle    @default(LIGHT)
  buttonStyle            KeyScreenControlStyle    @default(DARK)
  horizontalAlign        KeyScreenHorizontalAlign @default(CENTER)
  verticalAlign          KeyScreenVerticalAlign   @default(CENTER)
  offsetX                Int                      @default(0)
  offsetY                Int                      @default(0)
  desktopHorizontalAlign KeyScreenHorizontalAlign @default(CENTER)
  desktopVerticalAlign   KeyScreenVerticalAlign   @default(CENTER)
  desktopOffsetX         Int                      @default(0)
  desktopOffsetY         Int                      @default(0)
  mobileHorizontalAlign  KeyScreenHorizontalAlign @default(CENTER)
  mobileVerticalAlign    KeyScreenVerticalAlign   @default(CENTER)
  mobileOffsetX          Int                      @default(0)
  mobileOffsetY          Int                      @default(0)
  desktopFormOffsetX     Int                      @default(0)
  desktopFormOffsetY     Int                      @default(0)
  desktopPrivacyOffsetX  Int                      @default(0)
  desktopPrivacyOffsetY  Int                      @default(0)
  mobileFormOffsetX      Int                      @default(0)
  mobileFormOffsetY      Int                      @default(0)
  mobilePrivacyOffsetX   Int                      @default(0)
  mobilePrivacyOffsetY   Int                      @default(0)
  overlayStrength        Int                      @default(25)
  revision               Int                      @default(1)
  createdBy              Int?
  updatedBy              Int?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  globalSelection        KeyScreenSettings?
  preRegistrations       PreRegistration[]

  @@index([updatedAt])
  @@index([mediaAssetId])
}

model PreRegistration {
  userId                Int        @id
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  screenId              String?
  screen                KeyScreen? @relation(fields: [screenId], references: [id], onDelete: SetNull)
  submittedAt           DateTime   @default(now())
  launchCode            String?    @unique
  launchTokenHash       String?    @unique
  launchTokenExpiresAt  DateTime?
  launchTokenUsedAt     DateTime?
  launchClaimedAt       DateTime?
  launchSentAt          DateTime?
  launchErrorCode       String?
  confirmationClaimedAt DateTime?
  confirmationSentAt    DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([screenId, submittedAt])
  @@index([submittedAt])
}

model CirclePromotionRequest {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  status      String   @default("pending")
  requestedAt DateTime @default(now())
  promoteAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, promoteAt])
}

model CircleUpgradeRequest {
  id                 String                     @id @default(uuid())
  userId             Int
  fromCircle         Int                        @default(3)
  toCircle           Int                        @default(4)
  socialNetwork      CircleUpgradeSocialNetwork
  username           String
  usernameNormalized String
  status             CircleUpgradeRequestStatus @default(PENDING)
  requestNumber      Int
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  reviewedAt         DateTime?
  reviewedBy         String?
  notes              String?
  approvedAt         DateTime?
  processedAt        DateTime?
  processedById      Int?
  autoProcessAt      DateTime?

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  processedBy User? @relation("ProcessedRequests", fields: [processedById], references: [id])

  @@unique([userId, requestNumber])
  @@index([status, socialNetwork, usernameNormalized])
  @@index([fromCircle, toCircle, status])
}

model Historial {
  // ✅ FIX: en DB debe ser Int autoincrement (antes tenías String cuid())
  id                  Int      @id @default(autoincrement())
  userId              Int      @unique
  pedidosRealizados   Int      @default(0)
  articulosAdquiridos Int      @default(0)
  devoluciones        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("historial")
}

model DiscountCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  type      String
  percent   Int
  used      Boolean   @default(false)
  user      User      @relation(fields: [userId], references: [id])
  userId    Int
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  @@index([userId])
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  phone     String?
  line1     String
  line2     String?
  city      String
  state     String?
  zip       String
  country   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
}

model Cart {
  id          Int        @id @default(autoincrement())
  userId      Int?       @unique
  anonymousId String?    @unique
  itemsCount  Int        @default(0)
  subtotal    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CartItem[]
}

// Short-lived, consented presence only. No navigation history or contact data.
model LivePresence {
  visitorHash String   @id @db.VarChar(64)
  userId      Int?
  sessionId   String?
  anonymousId String?
  section     String   @db.VarChar(12)
  productId   Int?
  seenAt      DateTime @default(now()) @db.Timestamptz(3)
  @@index([seenAt])
}

model CartItem {
  id         Int            @id @default(autoincrement())
  cartId     Int
  variantId  Int
  qty        Int
  priceAtAdd Int
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  cart       Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([variantId])
}

// A checkout snapshot is created before a Stripe PaymentIntent is created.
// Order creation must use these frozen values rather than a mutable cart.
model CheckoutSnapshot {
  paymentStatus              String?
  paymentStatusAt            DateTime?                  @db.Timestamptz(3)
  paymentLiveMode            Boolean?
  id                         String                     @id @default(cuid())
  userId                     Int?
  anonymousId                String?
  customerEmail              String
  cartId                     Int
  cartUpdatedAt              DateTime
  requestFingerprint         String
  stripePaymentIntentId      String?                    @unique
  stripeAccountId            String?
  paymentRecoveryToken       String?
  paymentRecoveryClaimedAt   DateTime?
  status                     String                     @default("PENDING")
  currency                   String                     @default("EUR")
  subtotalCents              Int
  taxRate                    Decimal                    @db.Decimal(5, 4)
  taxAmountCents             Int
  shippingCostCents          Int                        @default(0)
  shippingMethodId           Int?
  shippingMethodCode         String?
  shippingMethodLabel        String?
  shippingMethodDescription  String?
  shippingMethodPriceCents   Int?
  discountCents              Int                        @default(0)
  disputeLostCents           Int                        @default(0)
  promoCodeId                Int?
  promoCodeCode              String?
  totalCents                 Int
  shippingAddr               Json?
  billingAddr                Json?
  confirmationEmailSentAt    DateTime?
  confirmationEmailClaimedAt DateTime?
  stockReturnedAt            DateTime?
  orderId                    Int?                       @unique
  expiresAt                  DateTime
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  user                       User?                      @relation(fields: [userId], references: [id])
  order                      Order?                     @relation("CheckoutSnapshotOrder", fields: [orderId], references: [id], onDelete: SetNull)
  items                      CheckoutSnapshotItem[]
  stockReservations          CheckoutStockReservation[]
  stockMovements             StockMovement[]
  activityEvents             CustomerActivityEvent[]

  @@index([userId, status])
  @@index([anonymousId, status])
  @@index([cartId])
  @@index([expiresAt])
  @@index([stripeAccountId, stripePaymentIntentId])
  @@index([userId, cartId, cartUpdatedAt, requestFingerprint])
}

model CheckoutSnapshotItem {
  financialSnapshot  CheckoutItemFinancial?
  id                 Int              @id @default(autoincrement())
  checkoutSnapshotId String
  productId          Int
  variantId          Int
  title              String
  unitPriceCents     Int
  quantity           Int
  lineTotalCents     Int
  checkoutSnapshot   CheckoutSnapshot @relation(fields: [checkoutSnapshotId], references: [id], onDelete: Cascade)

  @@index([checkoutSnapshotId])
  @@index([variantId])
}

// Inventory is reserved when a server-side checkout snapshot is created and
// either consumed by the resulting order or released after a safe cancellation.
model CheckoutStockReservation {
  id                 String           @id @default(cuid())
  checkoutSnapshotId String
  variantId          Int
  quantity           Int
  status             String           @default("RESERVED")
  releasedAt         DateTime?
  consumedAt         DateTime?
  returnedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  checkoutSnapshot   CheckoutSnapshot @relation(fields: [checkoutSnapshotId], references: [id], onDelete: Cascade)
  variant            ProductVariant   @relation(fields: [variantId], references: [id])

  @@unique([checkoutSnapshotId, variantId])
  @@index([variantId, status])
  @@index([checkoutSnapshotId, status])
}

// Stripe may deliver an event more than once and in a different order from
// related events. Store event identity and lifecycle state before acting on it.
model StripeWebhookEvent {
  refundCumulativeCents Int?
  id              String    @id
  type            String
  paymentIntentId String?
  lifecycleStatus String?
  amountCents     Int?
  status          String    @default("PROCESSING")
  error           String?
  occurredAt      DateTime
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([paymentIntentId, occurredAt])
  @@index([status, updatedAt])
}

model Order {
  paidAt               DateTime?
  id                   Int                     @id @default(autoincrement())
  status               OrderStatus             @default(PENDING)
  // Preserve fulfillment progress while a Stripe dispute is open. A later
  // reinstatement restores this state instead of downgrading a shipped or
  // delivered order back to PAID.
  preDisputeStatus     OrderStatus?
  trackingNumber       String?
  trackingUrl          String?
  shippingCarrier      String?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  internalNote         String?
  subtotal             Decimal                 @db.Decimal(12, 2)
  taxRate              Decimal                 @db.Decimal(5, 4)
  taxAmount            Decimal                 @db.Decimal(12, 2)
  shippingCost         Int                     @default(0)
  shippingMethodId     Int?
  shippingMethod       ShippingMethod?         @relation(fields: [shippingMethodId], references: [id])
  shippingMethodCode   String?
  discountCents        Int                     @default(0)
  disputeLostCents     Int                     @default(0)
  promoCodeId          Int?
  promoCodeCode        String?
  total                Decimal                 @db.Decimal(12, 2)
  currency             String                  @default("EUR")
  provider             String?
  providerRef          String?                 @unique
  source               OrderSource             @default(ONLINE)
  paymentMethod        OrderPaymentMethod?
  purchasedAt          DateTime?
  recordedById         Int?
  recordedBy           User?                   @relation("OrderRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  manualStockHandling  ManualStockHandling?
  manualIdempotencyKey String?                 @unique @db.VarChar(100)
  manualRequestHash    String?                 @db.VarChar(64)
  voidedAt             DateTime?
  voidedById           Int?
  voidedBy             User?                   @relation("OrderVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason           String?                 @db.VarChar(500)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  shippingAddr         Json?
  billingAddr          Json?
  customerEmail        String
  userId               Int?
  user                 User?                   @relation(fields: [userId], references: [id])
  items                OrderItem[]
  stockMovements       StockMovement[]
  promoCode            PromoCode?              @relation(fields: [promoCodeId], references: [id])
  promoCodeRedemptions PromoCodeRedemption[]
  checkoutSnapshot     CheckoutSnapshot?       @relation("CheckoutSnapshotOrder")
  activityEvents       CustomerActivityEvent[]

  @@index([userId])
  @@index([createdAt])
  @@index([status])
  @@index([source, createdAt])
  @@index([recordedById, createdAt])
}

model OrderItem {
  financialSnapshot OrderItemFinancial?
  id        Int             @id @default(autoincrement())
  orderId   Int
  productId Int
  variantId Int?
  title     String
  unitPrice Decimal         @db.Decimal(12, 2)
  quantity  Int
  lineTotal Decimal         @db.Decimal(12, 2)
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
}

// Private relations are never included by public product/cart/order queries.
model ProductCost {
  productId     Int      @id
  unitCostCents Int?
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CheckoutItemFinancial {
  itemId        Int                  @id
  unitCostCents Int?
  productName   String
  imageUrl      String?
  item          CheckoutSnapshotItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model OrderItemFinancial {
  itemId        Int       @id
  unitCostCents Int?
  productName   String
  imageUrl      String?
  item          OrderItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model StockMovement {
  id                 String            @id @default(cuid())
  variantId          Int
  delta              Int
  reason             String?
  note               String?           @db.VarChar(500)
  createdAt          DateTime          @default(now())
  orderId            Int?
  userId             Int?
  checkoutSnapshotId String?
  order              Order?            @relation(fields: [orderId], references: [id])
  user               User?             @relation(fields: [userId], references: [id])
  variant            ProductVariant    @relation(fields: [variantId], references: [id])
  checkoutSnapshot   CheckoutSnapshot? @relation(fields: [checkoutSnapshotId], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@index([orderId])
  @@index([variantId, createdAt])
  @@index([userId])
  @@index([checkoutSnapshotId])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
}

model NewsletterSubscription {
  id                    String    @id @default(cuid())
  email                 String    @unique
  verificationTokenHash String?   @unique
  verificationExpiresAt DateTime?
  verifiedAt            DateTime?
  subscribedAt          DateTime?
  welcomePromoCodeId    Int?      @unique
  welcomePromoCode      PromoCode? @relation(fields: [welcomePromoCodeId], references: [id], onDelete: Restrict)
  welcomeSentAt         DateTime?
  welcomeClaimedAt      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([verifiedAt])
}

/// Durable newsletter delivery and single-use access-link record. Public clients
/// never query this table directly; raw access tokens exist only in worker memory.
model NewsletterMailJob {
  id             String    @id @default(cuid())
  email          String
  kind           String
  status         String    @default("QUEUED")
  readyAt        DateTime  @default(now()) @db.Timestamptz(3)
  claimedAt      DateTime? @db.Timestamptz(3)
  claimToken     String?
  attempts       Int       @default(0)
  errorCode      String?
  sentAt         DateTime? @db.Timestamptz(3)
  tokenHash      String?   @unique
  tokenExpiresAt DateTime? @db.Timestamptz(3)
  tokenUsedAt    DateTime? @db.Timestamptz(3)
  userId         Int?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@index([status, readyAt])
  @@index([email, createdAt])
  @@index([userId, createdAt])
}

model PromoCode {
  firstOrderOnly       Boolean                @default(false)
  newsletterSubscription NewsletterSubscription?
  ownerUserId          Int?
  ownerEmail           String?
  id                   Int                   @id @default(autoincrement())
  code                 String                @unique
  type                 PromoCodeType
  value                Int
  minCartValue         Int?
  startsAt             DateTime?
  expiresAt            DateTime?
  isActive             Boolean               @default(true)
  singleUsePerUser     Boolean               @default(false)
  usageCount           Int                   @default(0)
  usageLimit           Int?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  orders               Order[]
  promoCodeRedemptions PromoCodeRedemption[]
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  action     String?
  actionType String?
  targetType String?
  targetId   String?
  fromCircle Int?
  toCircle   Int?
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@index([actionType])
  @@index([targetType])
  @@index([targetId])
  @@index([actorId, createdAt])
  @@index([actionType, targetType, createdAt])
  @@index([targetType, targetId])
}

model ShippingMethod {
  id        Int      @id @default(autoincrement())
  /// Nombre legible tipo "Envío estándar" / "Envío express"
  name      String
  /// Precio base del envío EN CÉNTIMOS
  price     Int
  isActive  Boolean  @default(true)
  countries String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model PromoCodeRedemption {
  id          Int      @id @default(autoincrement())
  promoCodeId Int
  userId      Int
  orderId     Int
  redeemedAt  DateTime @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, userId])
  @@index([userId])
  @@index([orderId])
}

model AdminNote {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  authorAdminId Int
  targetType    String
  targetId      String
  content       String   @db.Text
  isDeleted     Boolean  @default(false)

  author User @relation(fields: [authorAdminId], references: [id])

  @@index([authorAdminId])
  @@index([targetType, targetId])
}

/// Security/account access history. Deliberately stores coarse parsed client
/// properties only: never raw IP addresses, raw User-Agent strings or IDs that
/// could be combined into a fingerprint.
model UserLoginEvent {
  id                  String      @id @default(cuid())
  userId              Int
  browserFamily       String      @db.VarChar(40)
  browserMajorVersion String?     @db.VarChar(12)
  osFamily            String      @db.VarChar(40)
  deviceClass         DeviceClass
  createdAt           DateTime    @default(now())
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// A visit is an analytics session, not a page view. The browser-provided UUID
/// is scoped to the authenticated account and contains no identifying data.
model AnalyticsSession {
  id             String                  @id @db.Uuid
  userId         Int
  startedAt      DateTime                @default(now())
  lastActivityAt DateTime                @default(now())
  activeSeconds  Int                     @default(0)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  events         CustomerActivityEvent[]

  @@index([userId, startedAt])
  @@index([userId, lastActivityAt])
  @@index([lastActivityAt])
}

/// Strictly structured behaviour events. There is intentionally no JSON
/// metadata column: every accepted field is bounded and purpose-specific.
model CustomerActivityEvent {
  id                 String                    @id @default(cuid())
  userId             Int
  sessionId          String                    @db.Uuid
  eventType          CustomerActivityEventType
  clientEventId      String?                   @unique @db.Uuid
  productId          Int?
  variantId          Int?
  categorySlug       String?                   @db.VarChar(80)
  searchQuery        String?                   @db.VarChar(80)
  resultCount        Int?
  quantity           Int?
  previousQuantity   Int?
  activeSeconds      Int?
  checkoutSnapshotId String?
  orderId            Int?
  createdAt          DateTime                  @default(now())
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  session            AnalyticsSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product            Product?                  @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant            ProductVariant?           @relation(fields: [variantId], references: [id], onDelete: SetNull)
  checkoutSnapshot   CheckoutSnapshot?         @relation(fields: [checkoutSnapshotId], references: [id], onDelete: SetNull)
  order              Order?                    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([eventType, checkoutSnapshotId])
  @@index([userId, createdAt])
  @@index([userId, eventType, createdAt])
  @@index([sessionId, createdAt])
  @@index([userId, productId, eventType])
  @@index([createdAt])
}

