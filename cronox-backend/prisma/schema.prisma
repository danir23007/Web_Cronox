// prisma/schema.prisma
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

// [ORDERS] Estados disponibles para pedidos
enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
  SHIPPED
}

model Product {
  id        Int             @id @default(autoincrement())
  slug      String          @unique
  name      String
  price     Int             // en céntimos (79€ => 7900) para precisión
  currency  String          @default("EUR")
  imageUrl  String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  images    ProductImage[]
  variants  ProductVariant[]
  orderItems OrderItem[]    // [ORDERS]
}

model ProductVariant {
  id         Int             @id @default(autoincrement())
  productId  Int
  size       VariantSize
  sku        String          @unique
  price      Int?
  stockQty   Int             @default(0) @map("stock") // [STOCK]
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  product    Product         @relation(fields: [productId], references: [id])
  movements  StockMovement[]
  cartItems  CartItem[]

  @@index([productId])
  @@unique([productId, size])
}

enum VariantSize {
  XS
  S
  M
  L
  XL
  XXL
}

model StockMovement {
  id        String   @id @default(cuid())
  variantId Int
  delta     Int      // negativo en ventas, positivo en ajustes // [STOCK]
  reason    String?
  orderId   Int?
  userId    Int?
  createdAt DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id])
  order   Order?         @relation(fields: [orderId], references: [id])
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@index([orderId])
  @@index([variantId, createdAt])
  @@index([userId])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  url       String
  alt       String? @default("")
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, sortOrder])
}

model User {
  id               Int      @id @default(autoincrement())
  email            String   @unique
  passwordHash     String
  name             String?
  role             Role     @default(USER)
  isEmailVerified  Boolean  @default(false)
  refreshTokenHash String?  @db.VarChar(255)
  resetTokenHash   String?  @db.VarChar(255)
  resetTokenExp    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  addresses        Address[]
  carts            Cart[]
  stockMovements   StockMovement[]
  // [FIX] Orders relation temporarily disabled until user table exists
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  phone     String?
  line1     String
  line2     String?
  city      String
  state     String?
  zip       String
  country   String
  isDefault Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isDefault])
}

model Cart {
  id          Int        @id @default(autoincrement())
  userId      Int?       @unique
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousId String?    @unique

  items      CartItem[]

  itemsCount Int        @default(0)
  subtotal   Int        @default(0)

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model CartItem {
  id        Int            @id @default(autoincrement())
  cartId    Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  qty        Int
  priceAtAdd Int

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([variantId])
}

model ShippingMethod {
  id         Int      @id @default(autoincrement())
  name       String
  price      Int
  countries  String[] @default([])
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders Order[]
}

// [ORDERS] Pedido confirmado por el proveedor de pago
model Order {
  id           Int          @id @default(autoincrement())
  userId       String // [FIX]
  // [FIX] User relation temporarily removed while foreign key is disabled
  status       OrderStatus  @default(PENDING)
  subtotal     Decimal      @db.Decimal(12, 2)
  taxRate      Decimal      @db.Decimal(5, 4)
  taxAmount    Decimal      @db.Decimal(12, 2)
  shippingCost Decimal      @db.Decimal(12, 2)
  total        Decimal      @db.Decimal(12, 2)
  currency     String       @default("EUR")
  provider     String?
  providerRef  String?      @unique
  shippingMethodId Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  items        OrderItem[]
  shippingAddr Json?
  billingAddr  Json?
  shippingMethod ShippingMethod? @relation(fields: [shippingMethodId], references: [id])
  stockMovements StockMovement[]

  @@index([userId]) // [FIX]
  @@index([createdAt])
  @@index([status])
  @@index([shippingMethodId])
}

// [ORDERS] Línea de pedido que copia el carrito en el momento de la compra
model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  title     String
  unitPrice Decimal  @db.Decimal(12, 2)
  quantity  Int
  lineTotal Decimal  @db.Decimal(12, 2)

  @@index([orderId])
}
