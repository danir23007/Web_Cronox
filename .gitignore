/cronox-backend/node_modules/
/cronox-backend/dist/
node_modules/
test-results/
playwright-report/
.playwright-cli/

# All dotenv files are local-only. Safe examples remain trackable.
**/.env
**/.env.*
!**/.env.example

# Private browser state from reviews; do not hide source scripts under output.
/output/**/session-private.json
/output/**/mobile-private.json
/output/**/release-browser.json

# Reproducible integration report, not source or fixtures.
/output/mailbox-review/integration-results.json

# One-off mail intervention helpers, retained locally for reference.
# Reusable diagnostics are tracked under cronox-backend/scripts.
/output/mailbox-review/edit-campaign-quota.cjs
/output/mailbox-review/production-extensions.cjs
/output/mailbox-review/restore-extension-probe.cjs
/output/mailbox-review/retention-readonly.cjs

# Generated local browser verification artifacts.
/output/playwright/

# Reviewed local verification reports and runtime artifacts. Reusable source
# and fixtures are versioned under tests/, scripts/ and cronox-backend/scripts/.
/output/**/*.log
/output/**/*.pid
/output/**/*.patch
/output/**/*.png
/output/**/*.json
/output/**/*.txt
/output/**/*.private*
/output/**/*.dump
/output/stock-reservations/generated-client/

# One-off incident probes: fixed diagnostic sessions/IDs and local fixtures.
# The reusable recovery regression lives in tests/stock-reservations/.
/output/checkout-incident-20261027/*.cjs
/output/checkout-incident-20261027/*.cli.js
# Temporary copy of checkout-browser.cli.js with only a different local port.
/output/incident-checkout-browser.cli.js

/output/checkout-local-activation/*.private*
/output/checkout-local-activation/*.dump
/output/user-deletion-local-activation/*.private*
/output/user-deletion-local-activation/*.dump
/output/map-sale-points/*.dump
/output/map-sale-points/*.private*
/output/release-final-20261027/
/output/metacrilatos/
# Private recoverable backups and reviewed account maps must never enter Git.
output/private-user-numbering/

# Stripe sandbox tooling is local-only; production deploys the Git revision.
/cronox-backend/scripts/checkout-sandbox*.cjs
/cronox-backend/scripts/init-checkout-sandbox-db.cjs
/cronox-backend/scripts/playwright-sandbox.cjs
/cronox-backend/scripts/test-bank-abuse-sandbox.cjs
/cronox-backend/scripts/test-bank-transfer-local.cjs
/cronox-backend/scripts/test-checkout-stripe-sandbox.cjs
/cronox-backend/scripts/verify-express-paypal-sandbox.cjs
/cronox-backend/scripts/verify-physical-wallets.cjs
